# Optional online providers. API usage may incur charges; keep credentials private.
# xAI / Grok (Responses API)
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1
XAI_REASONING_EFFORT=low
XAI_TIMEOUT=120

# Groq
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Provider preference for ZEXA_BRAIN_MODE=auto: grok,groq,qwen
ZEXA_BRAIN_MODE=auto
ZEXA_PROVIDER_ORDER=grok,groq,qwen

# Local GGUF model and llama.cpp runtime (set the real path on your device).
ZEXA_LOCAL_MODEL=
ZEXA_LLAMA_CLI=llama-cli
ZEXA_LOCAL_THREADS=4
ZEXA_LOCAL_CONTEXT=2048
ZEXA_LOCAL_MAX_TOKENS=512
ZEXA_LOCAL_TIMEOUT=120

# Optional token displayed by the Zexa Bridge Android companion app.
ZEXA_BRIDGE_TOKEN=
ZEXA_BRIDGE_URL=http://127.0.0.1:8765
