# Required: create a Groq API key in your Groq account.
GROQ_API_KEY=
# Set a currently available model ID enabled for your account.
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: token displayed by the Zexa Bridge Android companion app.
ZEXA_BRIDGE_TOKEN=
ZEXA_BRIDGE_URL=http://127.0.0.1:8765
